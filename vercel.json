{
  "functions": {
    "api/*.ts": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/biz/:id",
      "destination": "/api/share?biz=:id"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "biz"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
